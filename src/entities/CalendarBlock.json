{
  "name": "CalendarBlock",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "start_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "deep_work",
        "learning",
        "outreach",
        "meeting",
        "personal",
        "other"
      ],
      "default": "other"
    }
  },
  "required": [
    "date",
    "start_time",
    "end_time",
    "title"
  ]
}