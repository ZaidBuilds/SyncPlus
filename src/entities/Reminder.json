{
  "name": "Reminder",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "deal_id": {
      "type": "string"
    },
    "contact_id": {
      "type": "string"
    },
    "due_date": {
      "type": "string",
      "format": "date-time"
    },
    "is_done": {
      "type": "boolean",
      "default": false
    },
    "is_auto": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "due_date"
  ]
}