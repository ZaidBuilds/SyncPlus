{
  "name": "AdvanceTaxPayment",
  "type": "object",
  "properties": {
    "financial_year": {
      "type": "string"
    },
    "instalment": {
      "type": "string",
      "enum": [
        "June",
        "September",
        "December",
        "March",
        "Self Assessment",
        "Other"
      ],
      "default": "Other"
    },
    "amount_paid": {
      "type": "number"
    },
    "date_paid": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "financial_year",
    "instalment",
    "amount_paid",
    "date_paid"
  ]
}
